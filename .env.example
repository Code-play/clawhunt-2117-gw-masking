# Gateway masking — copy to .env and export before running the service.
# Never commit a real key.  GW_MASK_KEY accepts either a base64-encoded 32-byte
# key or a passphrase of at least 16 characters (stretched with HKDF-SHA256).

# Required: key material for the AES-GCM mapping table.
GW_MASK_KEY=replace-with-a-32-byte-base64-key-or-a-long-passphrase

# Optional (defaults shown).
GW_MASK_TTL_SECONDS=600
GW_MASK_ENABLED_DEFAULT=true
GW_REDIS_URL=redis://127.0.0.1:6379/0
GW_DATABASE_URL=postgresql+psycopg://gw:gw@127.0.0.1:5432/gw
GW_VENDOR_BASE_URL=http://127.0.0.1:8001/v1
GW_VENDOR_TIMEOUT_SECONDS=10
GW_LOG_LEVEL=INFO
GW_ENV=local
